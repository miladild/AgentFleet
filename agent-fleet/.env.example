# Copy this file to .env.local. Everything here is optional: the defaults work for
# one machine running both the web UI and the backend.

# Web UI -> backend. The web UI is a Next.js app; the backend is the .NET agent.
AGENT_URL=http://localhost:8000

# Fully self-hosted, no cloud account: turn off CopilotKit's usage telemetry.
COPILOTKIT_TELEMETRY_DISABLED=true

# The web UI listens on this machine only (127.0.0.1). To let other machines on your
# network open it, set FLEET_WEB_HOST=0.0.0.0 (and read docs/security.md first: there
# is no login).
# FLEET_WEB_HOST=127.0.0.1
# PORT=3000

# ---------------------------------------------------------------------------
# Backend settings. The .NET backend reads these from ITS OWN process
# environment (or `dotnet user-secrets`), not from this file: Next.js loads
# .env.local but does not pass it on to the separately started backend.
#
# Machines, models, tools, MCP servers and the sandbox are NOT configured here.
# They live in fleet.config.json (next to the backend exe; see
# fleet.config.example.json) and can be edited from the web UI's Config panel.
# The HUB_OLLAMA_* / TRIAGE_OLLAMA_MODEL variables below only seed that file the
# very first time the backend starts with no fleet.config.json present.
# ---------------------------------------------------------------------------

# First-run seed for the single starting node and the small triage model.
# HUB_OLLAMA_URL=http://127.0.0.1:11434/v1
# HUB_OLLAMA_MODEL=qwen2.5-coder:7b
# TRIAGE_OLLAMA_MODEL=llama3.2:latest

# Where fleet.config.json lives (default: next to the backend exe).
# FLEET_CONFIG_PATH=

# The backend only answers requests addressed to localhost, an IP address or this
# machine's own name (protection against web pages, see docs/security.md). If you reach
# it through another host name, list it here, comma separated.
# FLEET_ALLOWED_HOSTS=

# Where the web UI can be reached FROM THE BACKEND. Used to check the diagrams
# in plans (a Mermaid parser runs in the web app).
# FLEET_FRONTEND_URL=http://localhost:3000

# How long to wait for one model answer, and how often node health is probed.
# FLEET_NETWORK_TIMEOUT_SECONDS=300
# FLEET_HEALTH_PROBE_TIMEOUT_SECONDS=3
# FLEET_HEALTH_CACHE_SECONDS=10

# Sandbox (run_sandboxed_code). Leave everything unset for the default: use this
# machine's Docker if it is installed, otherwise the tool is not offered. The same
# settings can be given as a "sandbox" section in fleet.config.json, which wins.
# SANDBOX_MODE=auto            # off | local | ssh | auto
# SANDBOX_SSH_HOST=            # ssh mode: the machine that has Docker
# SANDBOX_SSH_PORT=22
# SANDBOX_SSH_USER=            # default: the current user name
# SANDBOX_SSH_KEY_PATH=        # default: ~/.ssh/id_ed25519
# SANDBOX_SSH_SUDO=false       # prefix docker with sudo on that machine
# SANDBOX_EXECUTION_TIMEOUT_SECONDS=20

# run_command / run_git_command: how long one command may run.
# SHELL_EXECUTION_TIMEOUT_SECONDS=120

# read_file and friends: relative paths resolve against this folder. Absolute
# paths ignore it.
# FLEET_FILES_ROOT=

# Where the durable record of every conversation lives (a SQLite database), and where old
# JSON sessions are imported from (default: next to the backend exe). Where plans are stored.
# FLEET_CONTEXTS_DIR=
# FLEET_SESSIONS_DIR=
# FLEET_PLANS_DIR=
