<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>agent-fleet-a1b2c3d4-e5f6-4a1b-9c2d-3e4f5a6b7c8d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentFleet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 0.0.6 or later: 0.0.5 (pulled in by the AG-UI hosting preview) hid every server tool call in a run once the chat had
         used a web UI tool, so the chat drew no card for them. -->
    <PackageReference Include="AGUI.Abstractions" Version="1.0.1" />
    <PackageReference Include="AGUI.Server" Version="1.0.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.25.0-preview.261014.1" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.25.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- Microsoft.Data.Sqlite 9.0.0 brings SQLitePCLRaw 2.1.10, whose bundled SQLite has a published advisory
         (CVE-2025-6965, fixed from 2.1.12). The direct reference raises only the native library. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
    <PackageReference Include="OpenTelemetry" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
